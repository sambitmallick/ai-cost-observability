{
 "uid": "ai-cost",
 "title": "CI Copilot: what does my AI app cost?",
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 41,
 "panels": [
  {
   "id": 1,
   "title": "Total cost",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(ai_cost_usd_total{version=~\"$version\"})",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "title": "Requests (model calls)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(ai_requests_total{cached=\"no\",version=~\"$version\"})",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "Cost per model call",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(ai_cost_usd_total{version=~\"$version\"}) / sum(ai_requests_total{cached=\"no\",version=~\"$version\"})",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Answers cut off (max_tokens)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(ai_stop_reason_total{stop_reason=\"max_tokens\",version=~\"$version\"}) / sum(ai_stop_reason_total{version=~\"$version\"})",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.0001
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Requests over 100k tokens (5x price)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(ai_long_prompt_requests_total{version=~\"$version\"}) or vector(0)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.0001
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Response cache hit rate",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(ai_requests_total{cached=\"yes\",version=~\"$version\"}) / sum(ai_requests_total{version=~\"$version\"})",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Cost by feature",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (feature) (ai_cost_usd_total{version=~\"$version\"})",
     "legendFormat": "{{feature}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "left",
    "text": {
     "valueSize": 22,
     "titleSize": 18
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 8,
   "title": "Cost per call, by feature",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 5,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (feature) (ai_cost_usd_total{version=~\"$version\"}) / sum by (feature) (ai_requests_total{cached=\"no\",version=~\"$version\"})",
     "legendFormat": "{{feature}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "left",
    "text": {
     "valueSize": 22,
     "titleSize": 18
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 9,
   "title": "Cost by user tier",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 5,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tier) (ai_cost_usd_total{version=~\"$version\"})",
     "legendFormat": "{{tier}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "left",
    "text": {
     "valueSize": 22,
     "titleSize": 18
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 10,
   "title": "Spend rate ($/hour), by feature",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (feature) (rate(ai_cost_usd_total{version=~\"$version\"}[2m])) * 3600",
     "legendFormat": "{{feature}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 11,
   "title": "Tokens billed, by type",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (ai_tokens_total{type!=\"thinking\",version=~\"$version\"})",
     "legendFormat": "{{type}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "left",
    "text": {
     "valueSize": 22,
     "titleSize": 18
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 12,
   "title": "Prompt cache: share of prompt tokens read from cache",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (feature) (ai_tokens_total{type=\"cache_read\",version=~\"$version\"}) / sum by (feature) (ai_tokens_total{type=~\"input|cache_read|cache_write|cache_write_1h\",version=~\"$version\"})",
     "legendFormat": "{{feature}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "left",
    "text": {
     "valueSize": 22,
     "titleSize": 18
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 13,
   "title": "Latency p50 / p99, by feature",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 23,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (feature, le) (rate(ai_request_seconds_bucket{version=~\"$version\"}[5m])))",
     "legendFormat": "p99 {{feature}}",
     "instant": false
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.5, sum by (feature, le) (rate(ai_request_seconds_bucket{version=~\"$version\"}[5m])))",
     "legendFormat": "p50 {{feature}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  }
 ],
 "templating": {
  "list": [
   {
    "name": "version",
    "label": "app version",
    "type": "custom",
    "query": "v1,v2,v3",
    "current": {
     "text": "v1",
     "value": "v1"
    },
    "includeAll": true,
    "allValue": ".*",
    "options": []
   }
  ]
 }
}